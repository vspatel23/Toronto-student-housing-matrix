# Local development server port. Deployment platforms may set PORT automatically.
PORT=5000

# Required: MongoDB connection string. Replace the placeholder user, password,
# cluster host, and database name.
# MONGODB_URI is supported as a backward-compatible alternative to MONGO_URI;
# configure one of them, not both.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database_name
# MONGODB_URI=mongodb://127.0.0.1:27017/toronto-student-housing-matrix

# Required for registration, login, and authenticated routes.
JWT_SECRET=replace_with_a_long_random_secret

# Required only for natural-language search and AI comparison.
# Create a key at https://openrouter.ai/keys and keep it on the backend.
OPENROUTER_API_KEY=replace_with_an_openrouter_api_key

# Optional. Omit this variable to use the same application default.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional CORS origins in addition to the built-in local/Vercel origins.
# FRONTEND_URL accepts one origin; FRONTEND_URLS accepts comma-separated origins.
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=

# Never commit backend/.env or real production values.

# Local development server port. Deployment platforms may set PORT automatically.
PORT=5000

# Replace this placeholder with the real MongoDB URI locally or in the deployment provider.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database_name

# Replace this placeholder with a long random secret for signing login tokens.
JWT_SECRET=replace_with_a_long_random_secret

# Create a key at https://openrouter.ai/keys and store the real value only in backend/.env.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Use an OpenRouter model slug that supports structured outputs.
OPENROUTER_MODEL=your_openrouter_model_here

# Do not commit the real .env file or production secrets.

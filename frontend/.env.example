# Local development: point the frontend to the backend API.
VITE_API_URL=http://localhost:5000

# Production: set VITE_API_URL to the deployed backend URL.
# Do not commit real secrets or private environment values.

# Optional MapTiler browser key for the interactive results map.
# Create a protected key and restrict it to the allowed website origins.
# When omitted, the frontend uses OpenStreetMap tiles as a development fallback.
VITE_MAPTILER_KEY=

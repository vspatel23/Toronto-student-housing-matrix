# Required in deployment: absolute base URL of the Express API.
VITE_API_URL=http://localhost:5000

# Optional protected browser key for MapTiler tiles on Browse Results.
# Restrict a real key to the intended website origins. When blank, the result
# map falls back to OpenStreetMap; the Listing Details map uses OpenStreetMap.
VITE_MAPTILER_KEY=

# Vite embeds VITE_ values in public browser assets. Never put a MongoDB URI,
# JWT secret, OpenRouter key, personal token, or password in this file.
